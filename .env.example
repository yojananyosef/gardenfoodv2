# Plantilla de variables de entorno local.
# Copiar a .env.local y completar. NO se commitea: .env* esta en .gitignore.

# --- Conexion directa a Postgres ---
# Supabase > Settings > Database > Connection string > Connection pooler.
# La usa scripts/aplicar_migraciones.mjs. Es la UNICA forma de correr
# migraciones grandes: el MCP apply_migration exige que el SQL pase por el
# mensaje y la migracion de datos del Excel maestro son ~1 MB.
# NUNCA usar `supabase db push`: el remoto versiona con timestamp y el repo
# con NNNN_, asi que push reintentaria las migraciones ya aplicadas.
#
# Puerto 6543 = Transaction pooler, NO el 5432 (Session pooler). El de sesion
# no responde desde todas las maquinas; el de transaccion si. Para DDL es
# equivalente: Supavisor mantiene el backend fijado entre BEGIN y COMMIT.
DATABASE_URL=postgresql://postgres.ayhpmsocohrorabvrmow:<PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- API de Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://ayhpmsocohrorabvrmow.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ---
# Guardalo SIN comillas. Si el valor queda entrecomillado, las comillas
# pasan a formar parte del valor y next new URL() lo rechaza en build.
NEXT_PUBLIC_SITE_URL=https://gardenfoodv2.vercel.app